# Strapi Server Configuration
HOST=0.0.0.0
PORT=1337

# Strapi Security Keys (Generate using: node -p "require('crypto').randomBytes(32).toString('base64')")
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database Configuration (SQLite by default, configure for PostgreSQL/MySQL in production)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# For PostgreSQL (production)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=your_password
# DATABASE_SSL=false

# Spotify API Credentials
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# SoundCloud API Credentials
# Get from: https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id

# YouTube API Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key

# Instagram API Credentials (Instagram Basic Display API or Instagram Graph API)
# Get from: https://developers.facebook.com/apps/
# For Instagram Graph API (Business/Creator accounts):
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# Frontend URL for Preview/Live Preview
CLIENT_URL=http://localhost:3000
PREVIEW_URL=http://localhost:3000
PREVIEW_SECRET=your_preview_secret_key

# Node Environment
NODE_ENV=development
